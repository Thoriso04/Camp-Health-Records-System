# Frontend Environment Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_TITLE=Camp Health Records System

# Backend & Main Process Security Config
JWT_SECRET=chrs_dev_jwt_secret_key_2026_change_in_prod
DB_ENCRYPTION_KEY=sqlcipher_aes256_passphrase_32chars!
DB_PATH=./data/chrs_encrypted.db
NODE_ENV=development

# Google Sheet registration sync (optional; see docs/GOOGLE_SHEET_SYNC.md).
# On a camp laptop the same values normally live in <userData>/google-sync.json
# instead; environment variables here override that file and are handy in dev.
GOOGLE_SHEET_ID=<spreadsheet id or full sheet URL>
GOOGLE_SHEET_TAB=Form Responses 1
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/chrs-sheet-reader.json
